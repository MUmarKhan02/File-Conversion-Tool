@model FileConversionTool.Models.ConversionViewModel
@{
    ViewData["Title"] = "File Converter";
}

<div class="page-wrap">
    <header class="topbar">
        <div class="logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
            </svg>
        </div>
        <span class="topbar-title">File Converter</span>
        <span class="topbar-badge">ASP.NET Core + Razor MVC</span>

    </header>

    <form asp-action="Convert" method="post" enctype="multipart/form-data" id="convertForm">

        <!-- ── Step 1: Category then conversion ────────────────────── -->
        <div class="card">
            <p class="section-label">Step 1 — Select conversion type</p>

            <!-- Category boxes -->
            <div class="cat-grid">
                <button type="button" class="cat-btn" data-cat="text">
                    <div class="cat-icon cat-icon-text">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="8" y1="13" x2="16" y2="13"/>
                            <line x1="8" y1="17" x2="12" y2="17"/>
                        </svg>
                    </div>
                    <span class="cat-label">Text</span>
                    <span class="cat-sub">Conversion</span>
                    <span class="cat-chevron">›</span>
                </button>

                <button type="button" class="cat-btn" data-cat="data">
                    <div class="cat-icon cat-icon-data">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"/>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                        </svg>
                    </div>
                    <span class="cat-label">Data</span>
                    <span class="cat-sub">Conversion</span>
                    <span class="cat-chevron">›</span>
                </button>

                <button type="button" class="cat-btn" data-cat="image">
                    <div class="cat-icon cat-icon-image">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                    </div>
                    <span class="cat-label">Image</span>
                    <span class="cat-sub">Conversion</span>
                    <span class="cat-chevron">›</span>
                </button>
            </div>

            <!-- Converter sub-grids — shown when a category is selected -->
            <div class="fmt-panel" id="panel-text" style="display:none">
                <p class="panel-label">Text conversions</p>
                <div class="fmt-grid">
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="txt|pdf" data-input="txt" data-output="pdf" />
                        <span class="fmt-label">.TXT → PDF</span>
                        <span class="fmt-sub">Plain text → document</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="txt|docx" data-input="txt" data-output="docx" />
                        <span class="fmt-label">.TXT → DOC</span>
                        <span class="fmt-sub">Plain text → Word doc</span>
                    </label>
                </div>
            </div>

            <div class="fmt-panel" id="panel-data" style="display:none">
                <p class="panel-label">Data conversions</p>
                <div class="fmt-grid">
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="json|csv" data-input="json" data-output="csv" />
                        <span class="fmt-label">JSON → CSV</span>
                        <span class="fmt-sub">Objects → spreadsheet</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="csv|json" data-input="csv" data-output="json" />
                        <span class="fmt-label">CSV → JSON</span>
                        <span class="fmt-sub">Spreadsheet → objects</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="json|xml" data-input="json" data-output="xml" />
                        <span class="fmt-label">JSON → XML</span>
                        <span class="fmt-sub">JSON → markup</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="xml|json" data-input="xml" data-output="json" />
                        <span class="fmt-label">XML → JSON</span>
                        <span class="fmt-sub">Markup → objects</span>
                    </label>
                </div>
            </div>

            <div class="fmt-panel" id="panel-image" style="display:none">
                <p class="panel-label">Image conversions</p>
                <div class="fmt-grid">
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="jpg|png" data-input="jpg" data-output="png" />
                        <span class="fmt-label">JPG → PNG</span>
                        <span class="fmt-sub">Lossy → lossless</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="png|jpg" data-input="png" data-output="jpg" />
                        <span class="fmt-label">PNG → JPG</span>
                        <span class="fmt-sub">Lossless → lossy</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="png|webp" data-input="png" data-output="webp" />
                        <span class="fmt-label">PNG → WEBP</span>
                        <span class="fmt-sub">PNG → modern format</span>
                    </label>
                    <label class="fmt-btn">
                        <input type="radio" name="conversionKey" value="bmp|png" data-input="bmp" data-output="png" />
                        <span class="fmt-label">BMP → PNG</span>
                        <span class="fmt-sub">Bitmap → lossless</span>
                    </label>
                </div>
            </div>

            <input type="hidden" asp-for="InputFormat"  id="inputFormat" />
            <input type="hidden" asp-for="OutputFormat" id="outputFormat" />
        </div>

        <!-- ── Step 2: Drop file ───────────────────────────────────── -->
        <div class="card">
            <p class="section-label">Step 2 — Upload your file</p>
            <div class="dropzone" id="dropzone">
                <div class="drop-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <p class="drop-title" id="dropTitle">Drag &amp; drop your file here</p>
                <p class="drop-sub">or <span class="browse-link" id="browseLink">browse to upload</span></p>
                <span class="drop-pill" id="dropPill">Select a conversion first</span>
                <input type="file" asp-for="UploadedFile" id="fileInput" style="display:none" />
            </div>
            <button type="submit" class="convert-btn" id="convertBtn" disabled>
                Convert file
            </button>

            <!-- Progress bar — hidden until form is submitted -->
            <div id="progressWrap" style="display:none">
                <div class="progress-header">
                    <span id="progressLabel">Uploading file...</span>
                    <span id="progressPct">0%</span>
                </div>
                <div class="progress-track">
                    <div class="progress-bar" id="progressBar"></div>
                </div>
            </div>
        </div>

    </form>

    <!-- ── Result panel ────────────────────────────────────────────── -->
    @if (Model.Converted)
    {
        if (Model.Success)
        {
            <div class="result-card result-success">
                <div class="result-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                </div>
                <div class="result-text">
                    <p class="result-title">Conversion complete</p>
                    <p class="result-sub">@Model.Message</p>
                </div>
                <a class="dl-btn"
                   href="@Url.Action("Download", "Home", new { token = Model.DownloadToken, fileName = Model.OriginalFileName })">
                    Download @Model.OriginalFileName
                </a>
            </div>
        }
        else
        {
            <div class="result-card result-error">
                <div class="result-icon result-icon-err">
                    <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </div>
                <div class="result-text">
                    <p class="result-title">Conversion failed</p>
                    <p class="result-sub">@Model.Message</p>
                </div>
            </div>
        }
    }
</div>
